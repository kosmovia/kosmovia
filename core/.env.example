# Clave publicable de Pollar (login y wallet), segura para el navegador.
NEXT_PUBLIC_POLLAR_PUBLISHABLE_KEY=
# Clave secreta de Pollar, solo en el servidor.
POLLAR_SECRET_KEY=
# URL del proyecto de Supabase.
NEXT_PUBLIC_SUPABASE_URL=
# Clave anon (publica) de Supabase.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave privada ES256 con la que el servidor firma el JWT de Supabase.
SUPABASE_JWT_PRIVATE_KEY=
# Identificador (kid) de esa clave de firma.
SUPABASE_JWT_KEY_ID=
