# Clave publicable de Pollar (login y wallet), segura para el navegador.
NEXT_PUBLIC_POLLAR_PUBLISHABLE_KEY=
# Clave secreta de Pollar, solo en el servidor.
POLLAR_SECRET_KEY=
# URL del proyecto de Supabase.
NEXT_PUBLIC_SUPABASE_URL=
# Clave anon (publica) de Supabase.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave privada ES256 con la que el servidor firma el JWT de Supabase.
SUPABASE_JWT_PRIVATE_KEY=
# Identificador (kid) de esa clave de firma.
SUPABASE_JWT_KEY_ID=
# Secreto (16+ caracteres al azar) con el que el servidor deriva el código de verificación de X.
X_CHALLENGE_SECRET=
# --- Modo "api" (Postgres plano para pruebas, ver db/README.md). Vacio = Supabase. ---
# "api" para usar las rutas REST y la base de DATABASE_URL (servidor).
KOSMOVIA_DATA_BACKEND=
# El mismo valor, para el navegador.
NEXT_PUBLIC_KOSMOVIA_DATA_BACKEND=
# Cadena de conexion de la base de PRUEBAS (postgresql://usuario:clave@host/base).
DATABASE_URL=
# Secreto (32+ caracteres al azar) con el que se firma la cookie de sesion.
SESSION_SECRET=
