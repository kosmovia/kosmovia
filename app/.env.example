# ==============================================================================
# Kosmovia - Variables de entorno de ejemplo (copiar a .env.local)
# NO SUBIR VALORES REALES NI SECRETOS A GITHUB. Todo en testnet.
# ==============================================================================

# --- Capa de servicios ---------------------------------------------------------
# "api" usa el backend real de esta misma app (rutas /api); sin valor = demo con localStorage.
NEXT_PUBLIC_KOSMOVIA_SERVICES=api

# --- Base de datos ---------------------------------------------------------------
# "api" = Postgres plano por DATABASE_URL (Supabase, Render o local). Vacío = modo Supabase cliente.
KOSMOVIA_DATA_BACKEND=api
# El mismo valor, para el navegador.
NEXT_PUBLIC_KOSMOVIA_DATA_BACKEND=api
# Cadena de conexión de la base de PRUEBAS (postgresql://usuario:clave@host/base).
DATABASE_URL=
# Secreto (32+ caracteres al azar) con el que se firma la cookie de sesión.
SESSION_SECRET=

# --- Pollar (login y wallet) -----------------------------------------------------
# Clave publicable (testnet), segura para el navegador. Pídela por privado.
NEXT_PUBLIC_POLLAR_PUBLISHABLE_KEY=
# Clave secreta, solo en el servidor.
POLLAR_SECRET_KEY=

# --- Verificación de X -------------------------------------------------------------
# Secreto (16+ caracteres al azar) con el que se deriva el código de verificación de X.
X_CHALLENGE_SECRET=

# --- Notificaciones push (app instalable) ------------------------------------------
# Genera las claves una sola vez con:  npx web-push generate-vapid-keys
# La pública se muestra al navegador; la privada es secreta y va solo en el servidor.
# Sin las tres variables, el push queda apagado y la app funciona igual.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contacto del servidor, formato mailto:correo@ejemplo.com o https://tu-sitio
VAPID_SUBJECT=

# --- Solo para el modo Supabase cliente (KOSMOVIA_DATA_BACKEND vacío) --------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_JWT_PRIVATE_KEY=
SUPABASE_JWT_KEY_ID=

# --- Stellar -------------------------------------------------------------------------
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
